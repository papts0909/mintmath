# Copy to .env (docker-compose) or frontend/.env.local (vite dev). Never commit real values.

# --- Frontend (Vite, exposed to the browser) ---
# OAuth 2.0 Client ID (type "Web application") from Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=
# API key restricted to the Picker API and your origins.
VITE_GOOGLE_API_KEY=
# Google Cloud project number (Picker "app id").
VITE_GOOGLE_APP_ID=
# Base URL of the export API when it is on another origin (production).
# Leave empty in dev: Vite proxies /api to the backend.
VITE_API_BASE=
# "off" = no export server: .tex, print-to-PDF and PNG are produced on the device.
VITE_EXPORT_SERVER=
# Sub-path when the app is served from a folder, e.g. /mintmath/ on GitHub Pages.
VITE_BASE=

# --- Backend ---
# Comma-separated origins allowed by CORS (production frontend origin).
MATHPAD_CORS_ORIGINS=http://localhost:5173
# Export requests per minute per client IP (0 disables).
MATHPAD_RATE_LIMIT=20
# Concurrent compilations.
MATHPAD_MAX_CONCURRENT=2
# Compile time limit in seconds.
MATHPAD_COMPILE_TIMEOUT=20
# Set to 1 behind a trusted reverse proxy so X-Forwarded-For is used for rate limiting.
MATHPAD_TRUST_PROXY=0
