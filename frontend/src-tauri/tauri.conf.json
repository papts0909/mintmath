{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MintMath",
  "version": "1.0.0",
  "identifier": "app.mathpad.editor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npx vite build"
  },
  "app": {
    "windows": [
      {
        "title": "MintMath",
        "width": 1200,
        "height": 820,
        "minWidth": 380,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "msi", "deb", "appimage"],
    "category": "Education",
    "shortDescription": "Trình bày bài giải toán theo từng dòng",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "languages": ["Vietnamese", "English"] }
    }
  }
}
